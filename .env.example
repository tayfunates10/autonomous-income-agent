# Non-secret production identity/configuration
AIA_AGENT_ID=agent-prod-1
AIA_AGENT_DISPLAY_NAME=Authorized AI Representative
AIA_OWNER_REFERENCE=owner:primary
AIA_AGENT_DISCLOSURE=AI representative acting under explicit owner authorization.
AIA_OWNER_KEY_ID=owner-key-1
AIA_OWNER_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_KEY\n-----END PUBLIC KEY-----
AIA_BUDGET_LIMIT_MINOR=0
AIA_BUDGET_CURRENCY=TRY
AIA_ALLOWED_ORIGINS=https://api.example.com
AIA_CHECKPOINT_PATH=/var/lib/aia/checkpoint.json

# Bounded network defaults
AIA_NETWORK_TIMEOUT_MS=10000
AIA_MAX_RESPONSE_BYTES=1000000
AIA_MAX_REQUEST_BODY_BYTES=256000
AIA_MAX_REQUESTS_PER_WINDOW=60
AIA_RATE_WINDOW_MS=60000

# Credential references only. Never commit actual credentials.
# AIA_CREDENTIAL_BINDINGS_JSON=[{"origin":"https://api.example.com","header":"authorization","prefix":"Bearer ","secret":{"provider":"environment","name":"AIA_PROVIDER_TOKEN"}}]
# AIA_PROVIDER_TOKEN is supplied by the deployment secret store/runtime, not this file.

# FORBIDDEN: AIA_OWNER_PRIVATE_KEY_PEM
# Owner approval private signing material must remain outside the agent runtime.
